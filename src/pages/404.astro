---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTINENT_META, CONTINENT_ORDER } from '../lib/continent';

// GitHub Pages serves dist/404.html for any path it can't match, so this
// one file covers every dead URL on the site -- a mistyped address, a stale
// link from elsewhere, or a slug that changed. Astro builds src/pages/404.astro
// to exactly that path.
//
// Given a visitor here wanted a specific article, the useful thing is a way
// back in rather than an apology: the masthead already carries search and
// the full section nav, so this adds the most recent stories and the
// continent list underneath.
const articles = (await getCollection('articles', ({ data }) => data.reviewStatus === 'published')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const recent = articles.slice(0, 5);
const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Page not found | Chess Herald"
  description="That page doesn't exist. Search, browse the latest chess stories, or pick a continent."
  activeContinent="not-found"
  noindex
>
  <section class="notfound">
    <p class="code">Error 404</p>
    <h1>That page isn't here</h1>
    <p class="lede">
      The address may be mistyped, or the story may have moved. Search is in the top corner of every page, or start
      from one of these.
    </p>

    <div class="cols">
      <div>
        <span class="label">Latest stories</span>
        <ol class="recent">
          {
            recent.map((a) => (
              <li>
                <a href={`/articles/${a.slug}/`}>{a.data.title}</a>
                <span class="date">{dateFmt(a.data.publishDate)}</span>
              </li>
            ))
          }
        </ol>
        <p class="all"><a href="/archive/">All {articles.length} articles &rarr;</a></p>
      </div>

      <aside>
        <span class="label">By continent</span>
        <ul class="continents">
          {
            CONTINENT_ORDER.map((c) => (
              <li>
                <a href={`/continent/${c}/`}>{CONTINENT_META[c].navLabel}</a>
              </li>
            ))
          }
        </ul>
        <p class="all"><a href="/contact/">Report a broken link &rarr;</a></p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding: 48px 0 70px;
  }
  .code {
    margin: 0 0 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .notfound h1 {
    margin: 0 0 14px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 540;
    font-size: clamp(34px, 5.5vw, 52px);
    line-height: 1.08;
  }
  .lede {
    margin: 0 0 40px;
    max-width: 56ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 48px;
    align-items: start;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .label {
    display: block;
    margin-bottom: 14px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .recent,
  .continents {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .recent li {
    padding: 11px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .recent li:first-child {
    padding-top: 0;
  }
  .recent a {
    display: block;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 18px;
    line-height: 1.25;
    text-decoration: none;
    color: var(--ink);
  }
  .recent a:hover {
    color: var(--accent);
  }
  .recent .date {
    display: block;
    margin-top: 4px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
  }

  .continents li {
    padding: 8px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .continents a {
    text-decoration: none;
    color: var(--ink);
    font-size: 15.5px;
  }
  .continents a:hover {
    color: var(--accent);
  }

  .all {
    margin: 16px 0 0;
  }
  .all a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .all a:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
</style>
