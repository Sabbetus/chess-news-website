---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { excerptFrom } from '../lib/excerpt';
import { estimateReadMinutes } from '../lib/reading';

const allRecaps = await getCollection('articles', ({ data }) => data.reviewStatus === 'published' && data.type === 'recap');
const recaps = allRecaps.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Weekly Recaps | The Chess Herald"
  description="Every past Weekly Recap from The Chess Herald, newest first."
  activeContinent="recaps"
>
  <header class="section-head">
    <h1>Weekly Recaps</h1>
    <p>{recaps.length} {recaps.length === 1 ? 'recap' : 'recaps'}</p>
  </header>

  {
    recaps.length === 0 && (
      <section class="empty-state">
        <p>No recaps published yet -- check back soon.</p>
      </section>
    )
  }

  {
    recaps.length > 0 && (
      <section class="list">
        {recaps.map((r) => (
          <article class="row">
            <h2>
              <a href={`/articles/${r.slug}/`}>{r.data.title}</a>
            </h2>
            <p>{excerptFrom(r.body, 200)}</p>
            <div class="byline">
              <span>{estimateReadMinutes(r.body)} min read</span>
              <span class="dot">&bull;</span>
              <span>{dateFmt(r.data.publishDate)}</span>
            </div>
          </article>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .section-head {
    padding: 34px 0 10px;
    border-bottom: 1px solid var(--rule);
  }
  .section-head h1 {
    margin: 0 0 6px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 540;
    font-size: clamp(30px, 4.5vw, 44px);
  }
  .section-head p {
    margin: 0 0 20px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .empty-state {
    padding: 60px 0;
    text-align: center;
    color: var(--ink-soft);
  }

  .list {
    padding: 24px 0 10px;
    max-width: 680px;
  }
  .row {
    padding: 26px 0;
    border-bottom: 1px solid var(--rule-faint);
  }
  .row h2 {
    margin: 0 0 9px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 520;
    font-size: 26px;
    line-height: 1.2;
  }
  .row h2 a {
    text-decoration: none;
    color: var(--ink);
  }
  .row h2 a:hover {
    color: var(--accent);
  }
  .row p {
    margin: 0 0 11px;
    color: var(--ink-soft);
    font-size: 15.5px;
  }
  .row .byline {
    font-size: 11.5px;
    display: flex;
    gap: 8px;
    color: var(--ink-soft);
    font-family: 'IBM Plex Mono', monospace;
  }
</style>
