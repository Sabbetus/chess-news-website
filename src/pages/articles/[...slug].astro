---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleThumb from '../../components/ArticleThumb.astro';
import { LENS_META } from '../../lib/lens';
import { estimateReadMinutes } from '../../lib/reading';
import { excerptFrom } from '../../lib/excerpt';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.reviewStatus === 'published');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { Content } = await article.render();
const dateFmt = article.data.publishDate.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const description = excerptFrom(article.body, 200);
---

<BaseLayout
  title={`${article.data.title} | Chessori`}
  description={description}
  activeContinent={article.data.continent}
  articleMeta={{
    publishedTime: article.data.publishDate.toISOString(),
    source: article.data.sourceName,
  }}
>
  <article class="story">
    <ArticleThumb lens={article.data.lens} continent={article.data.continent} size="lead" image={article.data.image} />

    <div class="story-head">
      <h1>{article.data.title}</h1>
      <div class="byline">
        <span>{LENS_META[article.data.lens].label}</span>
        <span class="dot">&bull;</span>
        <a class="src" href={article.data.sourceUrl} target="_blank" rel="noopener">
          Source: {article.data.sourceName}
        </a>
        <span class="dot">&bull;</span>
        <span>{estimateReadMinutes(article.body)} min read</span>
        <span class="dot">&bull;</span>
        <span>{dateFmt}</span>
      </div>
    </div>

    <div class="story-body">
      <Content />
    </div>

    <p class="source-callout">
      By Claude Henry<br />
      Original source: <a href={article.data.sourceUrl} target="_blank" rel="noopener">{article.data.sourceUrl}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .story {
    padding: 34px 0 60px;
    /* A single shared width, rather than 68ch repeated on several
       elements -- ch resolves against each element's own font-size, and
       .story-body sets an explicit 18px while .story-head/.thumb don't
       (inheriting the body's 17px), so the same "68ch" was quietly
       computing to different pixel widths and misaligning the title,
       image, and body text. */
    --content-width: 680px;
  }
  .story :global(.thumb) {
    max-width: var(--content-width);
    margin: 0 auto 22px;
  }
  .story-head {
    max-width: var(--content-width);
    margin: 0 auto 30px;
  }
  .story-head h1 {
    margin: 0 0 16px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 540;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.008em;
    text-wrap: balance;
  }

  .story-body {
    max-width: var(--content-width);
    margin: 0 auto;
    font-size: 18px;
    line-height: 1.72;
  }
  .story-body :global(p) {
    margin: 0 0 1.3em;
  }
  .story-body :global(h2) {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 540;
    font-size: 28px;
    margin: 1.6em 0 0.6em;
  }
  .story-body :global(h3) {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 520;
    font-size: 22px;
    margin: 1.4em 0 0.5em;
  }
  .story-body :global(a) {
    color: var(--accent);
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }
  .story-body :global(blockquote) {
    margin: 1.4em 0;
    padding-left: 20px;
    border-left: 3px solid var(--brass);
    color: var(--ink-soft);
    font-style: italic;
  }

  .source-callout {
    max-width: var(--content-width);
    margin: 40px auto 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule-soft);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--ink-soft);
  }
  .source-callout a {
    color: var(--nordic);
  }
</style>
