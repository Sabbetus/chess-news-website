---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleThumb from '../../components/ArticleThumb.astro';
import TagRow from '../../components/TagRow.astro';
import { estimateReadMinutes } from '../../lib/reading';
import { excerptFrom } from '../../lib/excerpt';
import { seoTitle } from '../../lib/seoTitle';
import { CONTINENT_META } from '../../lib/continent';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.reviewStatus === 'published');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { Content } = await article.render();
const dateFmt = article.data.publishDate.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const shortDateFmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
// 155, not 200: Google truncates meta descriptions around 155-160 characters,
// so the tail of a longer one is cut mid-sentence in results. Feeds the
// JSON-LD description and og:description too, which have no such limit but
// read better consistent with what search actually shows.
const description = excerptFrom(article.body, 155);
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const correctionHref = `/contact/?${new URLSearchParams({
  topic: 'Article correction',
  title: article.data.title,
}).toString()}`;

// Similar articles: same continent or same lens, most recent first,
// excluding this one. Falls back to just "most recent overall" if there
// aren't enough matches, so the section is never empty once other
// articles exist.
const allArticles = await getCollection(
  'articles',
  ({ data, slug }) => data.reviewStatus === 'published' && slug !== article.slug
);
const related = allArticles
  .filter((a) => a.data.continent === article.data.continent || a.data.lens === article.data.lens)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const fallback = allArticles
  .filter((a) => !related.includes(a))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const similar = [...related, ...fallback].slice(0, 3);

const continentMeta = CONTINENT_META[article.data.continent];

// The social-card crop: fixed 1200x630 (1.91:1), the size Meta's own docs
// recommend for Facebook/Threads link previews and the same ratio X's
// summary_large_image card uses -- one crop serves all three. position=
// "top" matches the on-site thumb crop (see ArticleThumb.astro, and its
// comment on why "attention" was reverted) so the same photo reads the
// same way whether seen on the site or shared. jpg for broadest crawler
// compatibility (Facebook/Threads/X all handle it natively; no AVIF/WebP
// guessing needed on their end).
const ogImage = article.data.image
  ? await getImage({ src: article.data.image.src, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' })
  : null;
// JSON-LD's `image` has no crop requirement -- Google just wants a
// reasonably large, accessible copy (1280 clears its 1200px-wide
// preference) -- so this reuses the same source with a plain resize, no
// fixed aspect ratio forced onto it.
const jsonLdImage = article.data.image ? await getImage({ src: article.data.image.src, width: 1280, format: 'jpg' }) : null;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: article.data.title,
    description,
    datePublished: article.data.publishDate.toISOString(),
    // Falls back to the publish date rather than being omitted: for a piece
    // never corrected since publication, those genuinely are the same
    // moment, and search engines treat a missing dateModified as unknown
    // freshness rather than inferring it.
    dateModified: (article.data.updatedDate ?? article.data.publishDate).toISOString(),
    mainEntityOfPage: pageURL,
    url: pageURL,
    ...(jsonLdImage ? { image: [new URL(jsonLdImage.src, Astro.site).toString()] } : {}),
    // Organization, not Person. "Claude Henry" is a house byline, and this
    // is the one place the site made a typed, machine-readable claim that a
    // person by that name wrote the piece -- which contradicted llms.txt,
    // where the AI drafting is disclosed. The visible byline is unchanged;
    // institutional authorship is standard for news, and Google retired
    // author rich results, so Person was not buying anything either.
    author: { '@type': 'Organization', name: 'Chessori' },
    publisher: {
      '@type': 'Organization',
      name: 'Chessori',
      logo: { '@type': 'ImageObject', url: new URL('/favicon.png', Astro.site).toString() },
    },
    isBasedOn: article.data.sourceUrl,
    citation: article.data.sourceUrl,
  },
  // The site already has a real Home > Continent > Article hierarchy in its
  // URLs and nav; describing it in markup is what lets search results show
  // that trail instead of a bare URL.
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Chessori',
        item: new URL('/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: continentMeta.label,
        item: new URL(`/continent/${article.data.continent}/`, Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: article.data.title,
        item: pageURL,
      },
    ],
  },
];
---

<BaseLayout
  title={seoTitle(article.data.title)}
  ogTitle={`${article.data.title} | Chessori`}
  description={description}
  activeContinent={article.data.continent}
  articleMeta={{
    publishedTime: article.data.publishDate.toISOString(),
    source: article.data.sourceName,
  }}
  image={ogImage && new URL(ogImage.src, Astro.site).toString()}
  jsonLd={jsonLd}
>
  <article class="story">
    <ArticleThumb lens={article.data.lens} size="lead" image={article.data.image} alt={article.data.title} />

    <div class="story-head">
      <h1>{article.data.title}</h1>
      <TagRow lens={article.data.lens} continent={article.data.continent} />
      <div class="byline">
        <a class="src" href={article.data.sourceUrl} target="_blank" rel="noopener">
          Source: {article.data.sourceName}
        </a>
        <span class="dot">&bull;</span>
        <span>{estimateReadMinutes(article.body)} min read</span>
        <span class="dot">&bull;</span>
        <span>{dateFmt}</span>
      </div>
    </div>

    <div class="story-body">
      <Content />
    </div>

    <p class="source-callout">
      <span class="byline-credit">By Claude Henry</span><br />
      Original source: <a href={article.data.sourceUrl} target="_blank" rel="noopener">{article.data.sourceName}</a><br />
      <span class="correction-note">Noticed an error in the article? Report it from <a class="correction-link" href={correctionHref}>here</a>.</span>
    </p>

    {
      similar.length > 0 && (
        <section class="similar">
          <h2 class="similar-label">Similar Articles</h2>
          <div class="similar-grid">
            {similar.map((a, i) => (
              <article class="similar-card">
                <ArticleThumb lens={a.data.lens} size="card" seed={i} image={a.data.image} alt={a.data.title} href={`/articles/${a.slug}/`} />
                <h3>
                  <a href={`/articles/${a.slug}/`}>{a.data.title}</a>
                </h3>
                <TagRow lens={a.data.lens} continent={a.data.continent} />
                <div class="byline">
                  <span>{shortDateFmt(a.data.publishDate)}</span>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .story {
    padding: 34px 0 60px;
    /* A single shared width, rather than 68ch repeated on several
       elements -- ch resolves against each element's own font-size, and
       .story-body sets an explicit 18px while .story-head/.thumb don't
       (inheriting the body's 17px), so the same "68ch" was quietly
       computing to different pixel widths and misaligning the title,
       image, and body text. */
    --content-width: 680px;
  }
  .story :global(.thumb) {
    max-width: var(--content-width);
    margin: 0 auto 22px;
  }
  .story-head {
    max-width: var(--content-width);
    margin: 0 auto 30px;
  }
  .story-head h1 {
    margin: 0 0 16px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 540;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.008em;
  }

  .story-body {
    max-width: var(--content-width);
    margin: 0 auto;
    font-size: 18px;
    line-height: 1.72;
  }
  .story-body :global(p) {
    margin: 0 0 1.3em;
  }
  .story-body :global(h2) {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 540;
    font-size: 28px;
    margin: 1.6em 0 0.6em;
  }
  .story-body :global(h3) {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 520;
    font-size: 22px;
    margin: 1.4em 0 0.5em;
  }
  .story-body :global(a) {
    color: var(--accent);
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }
  .story-body :global(blockquote) {
    margin: 1.4em 0;
    padding-left: 20px;
    border-left: 3px solid var(--brass);
    color: var(--ink-soft);
    font-style: italic;
  }

  .source-callout {
    max-width: var(--content-width);
    /* Matches .similar's margin-top below -- measured empirically, the gap
       above this section's rule (40px) and below it, before the next
       section's rule (48px, from .similar's own margin-top), didn't
       match. Both now 48px so the section sits evenly between its
       neighbors. */
    margin: 48px auto 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule-soft);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--ink-soft);
    /* The source link now shows a short name (see below), but this stays
       as a defensive default -- the correction-link href/topic query
       string and other unbroken runs of text in this block could still
       overflow the content column on narrow viewports without it. */
    overflow-wrap: anywhere;
  }
  .source-callout a {
    color: var(--nordic);
  }
  .correction-note {
    display: inline-block;
    /* Matches .byline-credit's margin-bottom below -- these two, plus the
       plain source-link line between them, read as three stacked rows of
       one meta block, and the gaps between all three should be equal. */
    margin-top: 8px;
  }
  .source-callout a.correction-link {
    color: var(--ink-soft);
    text-decoration: underline;
  }
  .byline-credit {
    display: inline-block;
    margin-bottom: 8px;
  }

  .similar {
    max-width: var(--content-width);
    margin: 48px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  /* A real <h2> rather than a styled span: it's the heading for the
     section, and without it the h3 cards below sat directly under the
     article's h1 with nothing at level 2 in between -- a jump screen-reader
     users hit when navigating by heading. Styled to look exactly as it did
     as a span, so nothing moves visually; the explicit margin overrides the
     browser's default h2 spacing. */
  .similar-label {
    display: block;
    margin: 0 0 18px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .similar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .similar-card h3 {
    margin: 12px 0 8px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: 17px;
    line-height: 1.25;
  }
  .similar-card h3 a {
    text-decoration: none;
    color: var(--ink);
  }
  .similar-card h3 a:hover {
    color: var(--accent);
  }
  .similar-card .byline {
    font-size: 11px;
  }

  @media (max-width: 640px) {
    .similar-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
