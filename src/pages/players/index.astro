---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Portrait from '../../components/Portrait.astro';
import '../../styles/hubs.css';
import { TOP100, playerPages, federationName } from '../../lib/hubs';

// Every player with a profile page, A–Z by surname. Rankings live at
// /rankings/; this is the directory of people, including anyone who has
// since dropped out of the ranked lists.
const pages = await playerPages();
const openRank = new Map(TOP100.players.map((p) => [p.fideId, p.rank]));
const womenRank = new Map(TOP100.women.map((p) => [p.fideId, p.rank]));

// "Surname, Given", which is what the list is sorted by. Family name comes
// first already for these federations ("Ding Liren" -> "Ding, Liren");
// anything the rule gets wrong (van Foreest, Martínez Alcántara) sets
// sortName in its frontmatter.
const FAMILY_FIRST = new Set(['CHN', 'VIE', 'KOR']);
const listName = (p: (typeof pages)[number]) => {
  if (p.data.sortName) return p.data.sortName;
  const words = p.data.name.split(' ');
  if (words.length < 2) return p.data.name;
  return FAMILY_FIRST.has(p.data.federation)
    ? `${words[0]}, ${words.slice(1).join(' ')}`
    : `${words[words.length - 1]}, ${words.slice(0, -1).join(' ')}`;
};
const sortKey = (p: (typeof pages)[number]) =>
  listName(p).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const sorted = pages.sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
const groups = new Map<string, typeof sorted>();
for (const p of sorted) {
  const letter = sortKey(p)[0].toUpperCase();
  groups.set(letter, [...(groups.get(letter) ?? []), p]);
}

// Lower-case, accents stripped: what the search box matches against.
const fold = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

const description = `Profiles of ${pages.length} of the world's leading chess players: career highlights, current FIDE ranking, and The Chess Herald's coverage of each.`;
---

<BaseLayout title="Chess Players: Profiles and Rankings | The Chess Herald" description={description} activeSection="players">
  <div class="hub">
    <header class="hub-head">
      <h1>Players</h1>
      <p class="hub-lede">
        Profiles of the world's leading players, open and women, A–Z by surname. For the current order, see the
        <a href="/rankings/">FIDE rankings</a>.
      </p>
      <div class="player-search" hidden>
        <label for="playerSearch" class="visually-hidden">Search players</label>
        <input id="playerSearch" type="search" placeholder="Search players by name" autocomplete="off" spellcheck="false" />
        <p class="no-match" hidden>No player matches that name.</p>
      </div>
      <p class="letters">
        {[...groups.keys()].map((l) => <a href={`#letter-${l}`}>{l}</a>)}
      </p>
    </header>

    {
      [...groups.entries()].map(([letter, players]) => (
        <section class="hub-section" id={`letter-${letter}`}>
          <h2>{letter}</h2>
          <ul class="directory">
            {players.map((p) => (
              <li data-names={fold([p.data.name, listName(p), ...p.data.aliases].join(' '))}>
                <a href={`/players/${p.slug}/`}>
                  <Portrait name={p.data.name} image={p.data.image} size="small" />
                  <span class="who">
                    <span class="name">{listName(p)}</span>
                    <span class="meta">
                      {federationName(p.data.federation)}
                      {openRank.has(p.data.fideId) && <> · World No. {openRank.get(p.data.fideId)}</>}
                      {womenRank.has(p.data.fideId) && <> · Women No. {womenRank.get(p.data.fideId)}</>}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  // Filters the directory as you type (2026-11-18). Every word typed must
  // start a word of the player's name or one of its spellings, accents
  // ignored: "carl" finds Carlsen, "so we" finds Wesley So.
  const box = document.querySelector<HTMLElement>('.player-search');
  const input = document.querySelector<HTMLInputElement>('#playerSearch');
  if (box && input) {
    box.hidden = false;
    const fold = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const items = [...document.querySelectorAll<HTMLElement>('.directory li')].map((li) => ({
      li,
      words: (li.dataset.names ?? '').split(/[\s,.'-]+/).filter(Boolean),
    }));
    const sections = [...document.querySelectorAll<HTMLElement>('.hub-section')];
    const letters = document.querySelector<HTMLElement>('.letters');
    const none = box.querySelector<HTMLElement>('.no-match');
    input.addEventListener('input', () => {
      const terms = fold(input.value).split(/[\s,.'-]+/).filter(Boolean);
      let shown = 0;
      for (const { li, words } of items) {
        const hit = terms.every((t) => words.some((w) => w.startsWith(t)));
        li.hidden = !hit;
        if (hit) shown++;
      }
      for (const s of sections) s.hidden = !s.querySelector('li:not([hidden])');
      if (letters) letters.hidden = terms.length > 0;
      if (none) none.hidden = shown > 0;
    });
  }
</script>

<style>
  .letters[hidden],
  .hub-section[hidden],
  .directory li[hidden] {
    display: none;
  }
  .player-search {
    margin: 18px 0 0;
  }
  .player-search input {
    width: 100%;
    max-width: 420px;
    padding: 10px 12px;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
  .player-search input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .no-match {
    margin: 14px 0 0;
    color: var(--ink-soft);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .letters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 16px 0 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
  }
  .letters a {
    color: var(--accent);
    text-decoration: none;
  }
  .directory {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 10px 18px;
  }
  .directory a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    text-decoration: none;
    color: var(--ink);
  }
  .directory :global(.portrait) {
    flex: 0 0 52px;
    width: 52px;
  }
  .who {
    display: flex;
    flex-direction: column;
  }
  .name {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 16px;
    line-height: 1.2;
  }
  .directory a:hover .name {
    text-decoration: underline;
  }
  .meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 2px;
  }
</style>
