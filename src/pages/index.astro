---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleThumb from '../components/ArticleThumb.astro';
import { LENS_META } from '../lib/lens';
import { estimateReadMinutes } from '../lib/reading';
import { excerptFrom } from '../lib/excerpt';

const allArticles = await getCollection('articles', ({ data }) => data.reviewStatus === 'published');
const articles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const [lead, ...rest] = articles;
const secondary = rest.slice(0, 4);

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout title="Chessori" activeContinent="front-page">
  {
    !lead && (
      <section class="empty-state">
        <p>No articles published yet -- check back soon.</p>
      </section>
    )
  }

  {
    lead && (
      <section class="lead">
        <a href={`/articles/${lead.slug}/`}>
          <ArticleThumb lens={lead.data.lens} continent={lead.data.continent} size="lead" />
        </a>
        <div class="lead-cols">
          <div class="lead-main">
            <h2>
              <a href={`/articles/${lead.slug}/`}>{lead.data.title}</a>
            </h2>
            <p class="dek">{excerptFrom(lead.body, 280)}</p>
            <div class="byline">
              <a class="src" href={lead.data.sourceUrl} rel="noopener">
                Source: {lead.data.sourceName}
              </a>
              <span class="dot">&bull;</span>
              <span>{estimateReadMinutes(lead.body)} min read</span>
              <span class="dot">&bull;</span>
              <span>{dateFmt(lead.data.publishDate)}</span>
            </div>
          </div>
          {secondary.length > 0 && (
            <aside class="issue-index">
              <span class="label">In This Issue</span>
              <ol>
                {secondary.map((a, i) => (
                  <li>
                    <a href={`/articles/${a.slug}/`}>
                      <span class="num">{String(i + 2).padStart(2, '0')}</span>
                      <span class="txt">{a.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </aside>
          )}
        </div>
      </section>
    )
  }

  {
    secondary.length > 0 && (
      <section class="grid">
        {secondary.map((a, i) => (
          <article class="card">
            <a href={`/articles/${a.slug}/`}>
              <ArticleThumb lens={a.data.lens} continent={a.data.continent} size="card" seed={i + 1} />
            </a>
            <h3>
              <a href={`/articles/${a.slug}/`}>{a.data.title}</a>
            </h3>
            <p>{excerptFrom(a.body, 160)}</p>
            <div class="byline">
              <span class="src">Source: {a.data.sourceName}</span>
              <span class="dot">&bull;</span>
              <span>{LENS_META[a.data.lens].label}</span>
            </div>
          </article>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .empty-state {
    padding: 60px 0;
    text-align: center;
    color: var(--ink-soft);
  }

  .lead {
    padding: 34px 0 36px;
    border-bottom: 1px solid var(--rule);
  }
  .lead-cols {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 48px;
    align-items: start;
  }
  .lead h2 {
    margin: 0 0 14px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 520;
    font-size: clamp(32px, 4.2vw, 50px);
    line-height: 1.08;
    letter-spacing: -0.008em;
    text-wrap: balance;
    max-width: 21ch;
  }
  .lead h2 a {
    text-decoration: none;
    color: var(--ink);
  }
  .lead h2 a:hover {
    color: var(--accent);
  }
  .dek {
    max-width: 58ch;
    color: var(--ink-soft);
    font-size: 19px;
    line-height: 1.62;
    margin: 0 0 16px;
  }

  .issue-index {
    border-left: 1px solid var(--rule);
    padding-left: 28px;
  }
  .issue-index .label {
    font-family: 'Spectral Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 14px;
    display: block;
  }
  .issue-index ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .issue-index li {
    display: flex;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .issue-index li:first-child {
    padding-top: 0;
  }
  .issue-index li:last-child {
    border-bottom: none;
  }
  .issue-index .num {
    font-family: 'Spectral Mono', monospace;
    font-size: 12px;
    color: var(--brass);
    font-variant-numeric: tabular-nums;
    padding-top: 1px;
  }
  .issue-index .txt {
    font-family: 'Source Serif 4', serif;
    font-size: 14.5px;
    line-height: 1.35;
    color: var(--ink);
  }
  .issue-index a {
    text-decoration: none;
  }
  .issue-index a:hover .txt {
    color: var(--accent);
  }

  .grid {
    padding: 36px 0 10px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 46px;
    row-gap: 6px;
  }
  .card {
    padding: 24px 0;
    border-bottom: 1px solid var(--rule-faint);
  }
  .card h3 {
    margin: 0 0 9px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: 23px;
    line-height: 1.2;
    text-wrap: balance;
  }
  .card h3 a {
    text-decoration: none;
    color: var(--ink);
  }
  .card h3 a:hover {
    color: var(--accent);
  }
  .card p {
    margin: 0 0 11px;
    color: var(--ink-soft);
    font-size: 15.5px;
  }
  .card .byline {
    font-size: 11.5px;
  }

  @media (max-width: 860px) {
    .lead-cols {
      grid-template-columns: 1fr;
    }
    .issue-index {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--rule);
      padding-top: 20px;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
