---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleThumb from '../../../components/ArticleThumb.astro';
import TagRow from '../../../components/TagRow.astro';
import Pager from '../../../components/Pager.astro';
import { excerptFrom } from '../../../lib/excerpt';
import { estimateReadMinutes } from '../../../lib/reading';
import { sourceLabel } from '../../../lib/sources';
import { LENS_META, LENS_ORDER, LENS_SLUGS } from '../../../lib/lens';

// 24 a page: the biggest lens had grown to 99 stories on one page
// (about 57,000 px tall on a phone and 1.2 MB). Page 1 stays at /lens/<x>/.
export const getStaticPaths = (async ({ paginate }) => {
  const all = await getCollection('articles', ({ data }) => data.reviewStatus === 'published' && data.type !== 'recap');
  return LENS_ORDER.flatMap((lensKey) => {
    const articles = all
      .filter((a) => a.data.lens === lensKey)
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
    return paginate(articles, { params: { lens: LENS_SLUGS[lensKey] }, props: { lensKey }, pageSize: 24 });
  });
}) satisfies GetStaticPaths;

const { page, lensKey } = Astro.props as { page: any; lensKey: keyof typeof LENS_META };
const lens = lensKey;
const meta = LENS_META[lens];
const articles = page.data;

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout
  title={page.currentPage === 1 ? `${meta.label} | The Chess Herald` : `${meta.label} - Page ${page.currentPage} | The Chess Herald`}
  description={meta.description}
  activeSection={lens}
>
  <header class="section-head">
    <h1>{meta.label}</h1>
    <p class="desc">{meta.description}</p>
    <p class="count">{page.total} {page.total === 1 ? 'story' : 'stories'}</p>
  </header>

  {
    articles.length === 0 && (
      <section class="empty-state">
        <p>No {meta.label} stories published yet -- check back soon.</p>
      </section>
    )
  }

  {
    articles.length > 0 && (
      <section class="grid">
        {articles.map((a, i) => (
          <article class="card">
            <ArticleThumb
              lens={a.data.lens}
              size="card"
              seed={i}
              image={a.data.image}
              alt={a.data.title}
              href={`/articles/${a.slug}/`}
            />
            <h2>
              <a href={`/articles/${a.slug}/`}>{a.data.title}</a>
            </h2>
            <p>{excerptFrom(a.body, 160)}</p>
            <TagRow lens={a.data.lens} continent={a.data.continent} />
            <div class="byline">
              <span class="src">{sourceLabel(a.data)}</span>
              <span class="dot">&bull;</span>
              <span>{estimateReadMinutes(a.body)} min read</span>
              <span class="dot">&bull;</span>
              <span>{dateFmt(a.data.publishDate)}</span>
            </div>
          </article>
        ))}
      </section>
    )
  }

  <Pager page={page} label={`${meta.label} pages`} />
</BaseLayout>

<style>
  .section-head {
    padding: 34px 0 10px;
  }
  .section-head h1 {
    margin: 0 0 6px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 540;
    font-size: clamp(30px, 4.5vw, 44px);
  }
  .section-head .desc {
    margin: 0 0 10px;
    color: var(--ink-soft);
    font-size: 15.5px;
    /* No max-width -- 60ch (~465px at this font size) wrapped far too
       early relative to the available column width (.wrap caps at
       1100px), especially now that the OTB Tournaments description runs
       long. Let it use the full content column on wide viewports; the
       page's own .wrap max-width already keeps it from stretching too
       far on very large screens. */
    max-width: 100%;
  }
  .section-head .count {
    margin: 0 0 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .empty-state {
    padding: 60px 0;
    text-align: center;
    color: var(--ink-soft);
  }

  .grid {
    padding: 0 0 10px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 46px;
    row-gap: 6px;
  }
  .card {
    padding: 24px 0;
  }
  .card h2 {
    margin: 0 0 9px;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: 23px;
    line-height: 1.2;
  }
  .card h2 a {
    text-decoration: none;
    color: var(--ink);
  }
  .card h2 a:hover {
    color: var(--accent);
  }
  .card p {
    margin: 0 0 11px;
    color: var(--ink-soft);
    font-size: 15.5px;
  }
  .card .byline {
    font-size: 11.5px;
    gap: 8px;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
