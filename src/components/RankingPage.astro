---
// One rankings page. Every list (open classical, rapid and blitz top 100;
// women's, junior and girls top 25 for each) is built from FIDE's monthly
// lists by scripts/fide_ratings.py into data/fide-top100.json and shares
// this layout, table and tab row (user's call, 2026-11-18).
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/hubs.css';
import RankingTable from './RankingTable.astro';
import { seoTitle } from '../lib/seoTitle';
import { TOP100, periodLabel, playerPages, longDate, type RankedPlayer } from '../lib/hubs';

// Every page is a time control x category: Classical/Rapid/Blitz, then
// Open/Women/Juniors/Girls (user's call, 2026-11-18). Data keys in
// data/fide-top100.json: "players", "women", "juniors", "girls" for classical,
// "rapid"/"rapidWomen"/... and "blitz"/"blitzWomen"/... for the others.
export type TimeControl = 'classical' | 'rapid' | 'blitz';
export type Category = 'open' | 'women' | 'juniors' | 'girls';

interface Props {
  tc: TimeControl;
  cat: Category;
}
const { tc, cat } = Astro.props;

const month = periodLabel(TOP100.period);
const cutoff = (TOP100 as { juniorCutoff?: number }).juniorCutoff;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const dataKey = (t: TimeControl, c: Category) =>
  t === 'classical' ? (c === 'open' ? 'players' : c) : c === 'open' ? t : t + cap(c);
const pathOf = (t: TimeControl, c: Category) =>
  `/rankings/${t === 'classical' ? '' : `${t}/`}${c === 'open' ? '' : `${c}/`}`;
const rows = ((TOP100 as Record<string, unknown>)[dataKey(tc, cat)] ?? []) as RankedPlayer[];

const n = rows.length;
const tcWord = tc === 'classical' ? '' : `${cap(tc)} `;
const sourceName = `FIDE ${tc === 'classical' ? 'standard' : tc} rating list`;
const CAT = {
  open: { h1: `FIDE ${tcWord}Top ${n}`, noun: 'players', extra: '' },
  women: { h1: `FIDE ${tcWord}Women's Top ${n}`, noun: 'women', extra: '' },
  juniors: { h1: `FIDE ${tcWord}Junior Top ${n}`, noun: 'juniors', extra: `: players born in ${cutoff} or later` },
  girls: { h1: `FIDE ${tcWord}Girls Top ${n}`, noun: 'girls', extra: `: players born in ${cutoff} or later` },
}[cat];
const meta = {
  path: pathOf(tc, cat),
  h1: CAT.h1,
  title: `${CAT.h1} Chess Players${cat === 'juniors' || cat === 'girls' ? ' (Under 20)' : ''}, ${month}`,
  // Kept to three lines on phones (user's call, 2026-11-20).
  lede: `The ${cat === 'open' ? "world's " : ''}${n} highest-rated active ${CAT.noun}${cat === 'juniors' || cat === 'girls' ? ` (born ${cutoff} or later)` : ''} in ${tc} chess, from FIDE's ${tc === 'classical' ? 'standard' : tc} list.`,
  who: `top ${n} active ${tc === 'classical' ? '' : `${tc} `}${cat === 'open' ? 'chess players' : cat === 'women' ? 'women chess players' : `${CAT.noun} (under 20)`}`,
  source: sourceName,
};

const TCS: { key: TimeControl; label: string }[] = [
  { key: 'classical', label: 'Classical' },
  { key: 'rapid', label: 'Rapid' },
  { key: 'blitz', label: 'Blitz' },
];
const CATS: { key: Category; label: string }[] = [
  { key: 'open', label: 'Open' },
  { key: 'women', label: 'Women' },
  { key: 'juniors', label: 'Juniors' },
  { key: 'girls', label: 'Girls' },
];

const pages = await playerPages();
const pageById = new Map(pages.map((p) => [p.data.fideId, p]));
const leader = rows[0];
// Every list's entries, for the search box's "ranked elsewhere" line: when a
// name isn't in this list, the page says where the player is ranked.
const foldName = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const rankIndex: { n: string; name: string; fid: string; list: string; href: string; rank: number }[] = [];
for (const t of ['classical', 'rapid', 'blitz'] as TimeControl[]) {
  for (const c of ['open', 'women', 'juniors', 'girls'] as Category[]) {
    if (t === tc && c === cat) continue;
    const list = ((TOP100 as Record<string, unknown>)[dataKey(t, c)] ?? []) as RankedPlayer[];
    // "World No. 4", "Women's No. 3", "Rapid No. 41", "Blitz girls No. 7".
    const catWord = c === 'open' ? '' : c === 'women' ? "women's" : c === 'juniors' ? 'junior' : 'girls';
    const label = t === 'classical' ? (catWord ? cap(catWord) : 'World') : `${cap(t)}${catWord ? ` ${catWord}` : ''}`;
    for (const p of list) {
      const page = pageById.get(p.fideId);
      rankIndex.push({
        n: foldName([p.name, page?.data.name ?? '', ...(page?.data.aliases ?? [])].join(' ')),
        name: page?.data.name ?? p.name,
        fid: p.fideId,
        list: label,
        href: pathOf(t, c),
        rank: p.rank,
      });
    }
  }
}
const description = `The world's ${meta.who} on FIDE's ${month} list, with each player's rating, monthly change and federation.${
  leader ? ` ${leader.name} leads on ${leader.rating}.` : ''
}`;
const siteURL = new URL(meta.path, Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: meta.title,
    url: siteURL,
    numberOfItems: rows.length,
    itemListElement: rows.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      ...(pageById.has(p.fideId) ? { url: new URL(`/players/${pageById.get(p.fideId)!.slug}/`, Astro.site).toString() } : {}),
    })),
  },
];
---

<BaseLayout title={seoTitle(meta.title)} description={description} activeSection="rankings" jsonLd={jsonLd}>
  <div class="hub">
    <header class="hub-head">
      <h1 style={`--len: ${meta.h1.length}`}>{meta.h1}</h1>
      <p class="list-month">{month} rating list</p>
      <p class="hub-lede">{meta.lede}</p>
    </header>

    <nav class="rank-switch" aria-label="Time control">
      {TCS.map((t) => (
        <a href={pathOf(t.key, 'open')} class={t.key === tc ? 'on' : ''} aria-current={t.key === tc && cat === 'open' ? 'page' : undefined}>
          {t.label}
        </a>
      ))}
    </nav>
    <nav class="rank-sub" aria-label={`${cap(tc)} lists`}>
      {CATS.map((c) => (
        <a href={pathOf(tc, c.key)} class={c.key === cat ? 'on' : ''} aria-current={c.key === cat ? 'page' : undefined}>
          {c.label}
        </a>
      ))}
    </nav>

    <div class="list-search" hidden>
      <label for="rankSearch" class="visually-hidden">Search this list</label>
      <input id="rankSearch" type="search" placeholder="Search players by name" autocomplete="off" spellcheck="false" />
      <p class="no-match" hidden></p>
    </div>
    <script type="application/json" id="rankIndex" set:html={JSON.stringify(rankIndex)} />

    <section class="hub-section top100">
      <RankingTable rows={rows} pageById={pageById} />
      <p class="note">
        Source: <a href={TOP100.sourceUrl} target="_blank" rel="noopener">{meta.source}</a>, {month}. Active players
        only. +/− is the change from the previous month's list; age is approximate (birth year only). Updated
        {longDate(new Date(`${TOP100.fetchedAt}T00:00:00Z`))}.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  // Filters the table as you type (2026-11-20), like the players and events
  // pages. When nobody in this list matches, says where matching players
  // are ranked on the other lists ("Women's No. 3 · Rapid open No. 41").
  const box = document.querySelector<HTMLElement>('.list-search');
  const input = document.querySelector<HTMLInputElement>('#rankSearch');
  if (box && input) {
    box.hidden = false;
    const fold = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const split = (s: string) => s.split(/[\s,.'()-]+/).filter(Boolean);
    const rows = [...document.querySelectorAll<HTMLElement>('.data-table tbody tr')].map((tr) => ({
      tr,
      words: split(tr.dataset.names ?? ''),
    }));
    type Entry = { n: string; name: string; fid: string; list: string; href: string; rank: number };
    let index: Entry[] = [];
    try {
      index = JSON.parse(document.getElementById('rankIndex')?.textContent || '[]');
    } catch {
      index = [];
    }
    const none = box.querySelector<HTMLElement>('.no-match')!;
    const matches = (words: string[], terms: string[]) => terms.every((t) => words.some((w) => w.startsWith(t)));
    input.addEventListener('input', () => {
      const terms = split(fold(input.value));
      let shown = 0;
      for (const { tr, words } of rows) {
        const hit = matches(words, terms);
        tr.hidden = !hit;
        if (hit) shown++;
      }
      none.hidden = shown > 0 || terms.length === 0;
      if (none.hidden) return;
      const byPlayer = new Map<string, Entry[]>();
      for (const e of index) {
        if (!matches(split(e.n), terms)) continue;
        byPlayer.set(e.fid, [...(byPlayer.get(e.fid) ?? []), e]);
      }
      none.replaceChildren();
      if (byPlayer.size === 0) {
        none.textContent = 'No player matches that name in any of our ranking lists.';
        return;
      }
      none.append('Not in this list. ');
      [...byPlayer.values()].slice(0, 5).forEach((entries, i) => {
        if (i) none.append(document.createElement('br'));
        const strong = document.createElement('strong');
        strong.textContent = `${entries[0].name}: `;
        none.append(strong);
        entries.forEach((e, j) => {
          if (j) none.append(' · ');
          const a = document.createElement('a');
          a.href = e.href;
          a.textContent = `${e.list} No. ${e.rank}`;
          none.append(a);
        });
      });
    });
  }
</script>

<style>
  /* A little less space above the list buttons, to make room for the
     search box (user's call, 2026-11-20). */
  .hub-head {
    margin-bottom: 16px;
  }
  /* Phones: the list title stays on one line ("FIDE Blitz Women's Top 25"
     is the longest), scaled down with the screen width. */
  @media (max-width: 640px) {
    .hub-head h1 {
      white-space: nowrap;
      /* up to about 0.6em per character in Fraunces at this weight */
      font-size: min(30px, calc((100vw - 40px) / (var(--len) * 0.62)));
    }
  }
  .data-table tbody tr[hidden] {
    display: none;
  }
  .list-search {
    max-width: var(--content-width);
    margin: 14px auto 6px;
  }
  .list-search input {
    width: 100%;
    max-width: 420px;
    padding: 10px 12px;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
  .list-search input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .no-match {
    margin: 14px 0 0;
    color: var(--ink-soft);
    line-height: 1.7;
  }
  .no-match a {
    color: var(--accent);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .list-month {
    margin: -4px 0 14px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .rank-switch {
    max-width: var(--content-width);
    margin: 0 auto 18px;
    display: flex;
    gap: 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .rank-switch a {
    flex: 0 1 auto;
    padding: 9px 20px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .rank-switch a:hover {
    color: var(--ink);
    border-color: var(--ink-soft);
  }
  .rank-switch a.on {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--paper);
  }
  /* The classical list's categories, under the time-control tabs. */
  .rank-sub {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin-top: -4px;
    padding: 0 2px 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .rank-sub a {
    padding: 6px 0;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .rank-sub a:hover {
    color: var(--ink);
  }
  .rank-sub a.on {
    color: var(--blue);
    font-weight: 500;
    border-bottom-color: var(--blue);
  }
</style>
