---
// Client-side search: fetches the small static index at /search-index.json
// once (there's no backend to query on a static site) and filters it
// locally by substring match against title/excerpt as the visitor types.
---

<div class="search-box" id="searchBox">
  <input
    type="search"
    id="searchInput"
    class="search-input"
    placeholder="Search"
    autocomplete="off"
    aria-label="Search articles"
  />
  <div class="search-results" id="searchResults" hidden></div>
</div>

<script is:inline>
  (function () {
    var box = document.getElementById('searchBox');
    var input = document.getElementById('searchInput');
    var results = document.getElementById('searchResults');
    if (!box || !input || !results) return;

    var index = null;
    var indexPromise = null;

    function loadIndex() {
      if (!indexPromise) {
        indexPromise = fetch('/search-index.json')
          .then(function (res) {
            return res.json();
          })
          .then(function (data) {
            index = data;
            return data;
          })
          .catch(function () {
            index = [];
            return index;
          });
      }
      return indexPromise;
    }

    function render(matches, query) {
      results.innerHTML = '';
      if (!query) {
        results.hidden = true;
        return;
      }
      if (matches.length === 0) {
        var empty = document.createElement('div');
        empty.className = 'search-empty';
        empty.textContent = 'No matching articles.';
        results.appendChild(empty);
        results.hidden = false;
        return;
      }
      matches.slice(0, 8).forEach(function (item) {
        var a = document.createElement('a');
        a.className = 'search-result';
        a.href = '/articles/' + item.slug + '/';
        var title = document.createElement('span');
        title.className = 'search-result-title';
        title.textContent = item.title;
        var meta = document.createElement('span');
        meta.className = 'search-result-meta';
        meta.textContent = item.sourceName;
        a.appendChild(title);
        a.appendChild(meta);
        results.appendChild(a);
      });
      results.hidden = false;
    }

    function search(query) {
      var q = query.trim().toLowerCase();
      if (!q) {
        render([], '');
        return;
      }
      loadIndex().then(function (data) {
        var matches = data.filter(function (item) {
          return item.title.toLowerCase().indexOf(q) !== -1 || item.excerpt.toLowerCase().indexOf(q) !== -1;
        });
        render(matches, q);
      });
    }

    input.addEventListener('input', function () {
      search(input.value);
    });
    input.addEventListener('focus', function () {
      if (input.value.trim()) search(input.value);
    });
    document.addEventListener('click', function (e) {
      if (!box.contains(e.target)) {
        results.hidden = true;
      }
    });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        input.blur();
        results.hidden = true;
      }
    });
  })();
</script>

<style>
  .search-box {
    position: relative;
  }
  .search-input {
    width: 140px;
    padding: 5px 10px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--ink);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    text-transform: none;
    transition: width 0.15s ease;
  }
  .search-input::placeholder {
    color: var(--ink-soft);
    opacity: 1;
  }
  .search-input:focus {
    width: 200px;
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  /* The results below are appended via document.createElement in the
     inline script, not written in this component's template -- so Astro's
     scoped-CSS attribute (which it only stamps onto template-authored
     elements) never lands on them. Without :global() here, every rule
     targeting them is silently dropped and they fall back to whatever
     ambient styles their ancestors impose (in this case .masthead-top's
     uppercase), which is exactly the "bad UI" this replaces. */
  :global(.search-results) {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 320px;
    max-height: 400px;
    overflow-y: auto;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    z-index: 20;
    text-transform: none;
  }
  :global(.search-result) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    text-decoration: none;
    border-bottom: 1px solid var(--rule-faint);
  }
  :global(.search-result:last-child) {
    border-bottom: none;
  }
  :global(.search-result:hover) {
    background: var(--paper-raised);
  }
  :global(.search-result-title) {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: 15px;
    color: var(--ink);
    line-height: 1.35;
  }
  :global(.search-result-meta) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  :global(.search-empty) {
    padding: 14px;
    font-size: 13px;
    color: var(--ink-soft);
    text-transform: none;
  }

  @media (max-width: 640px) {
    .search-input,
    .search-input:focus {
      width: 110px;
    }
    :global(.search-results) {
      width: 240px;
    }
  }
</style>
