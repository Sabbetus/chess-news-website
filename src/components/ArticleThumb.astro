---
import { LENS_META, pieceForLens, type Lens } from '../lib/lens';
import { buildSrcset, resizeUrl } from '../lib/wikimediaSrcset';

interface Props {
  lens: Lens;
  size: 'lead' | 'card';
  seed?: number;
  image?: { url: string; credit: string; sourceUrl: string };
  alt?: string;
  href?: string;
}
const { lens, size, seed = 0, image, alt = '', href } = Astro.props;
const lensMeta = LENS_META[lens];
const piece = pieceForLens(lens, seed);

// images.py requests every Commons photo at a flat 1200px width regardless
// of where it ends up displayed -- the lead image only ever renders around
// ~680px CSS wide and grid cards well under that, so shipping the full
// 1200px JPEG everywhere was the single largest PageSpeed cost on the
// site. Build a real srcset from the already-stored URL (no re-fetch, no
// pipeline change) so the browser picks a width close to what it actually
// needs.
//
// The base `src` is resized too, not just the srcset -- some stored URLs
// are the raw, un-resized Commons original rather than a thumbnail
// (MediaWiki's API sometimes omits thumburl; observed on a file 1.17MB in
// size), and browsers that ignore srcset/sizes would otherwise still fetch
// that full original via src.
const maxWidth = size === 'lead' ? 960 : 500;
const src = image && resizeUrl(image.url, maxWidth);
// Widths here must be ones Wikimedia's thumbnail service actually serves
// for direct/hotlinked requests (resizeUrl/buildSrcset round up to the
// nearest one) -- see lib/wikimediaSrcset.ts for the full list and why.
const srcset = image && buildSrcset(image.url, [330, 500, 960]);
const sizes = size === 'lead' ? '(max-width: 700px) 100vw, 680px' : '(max-width: 640px) 100vw, 45vw';

// The lead image is always the single largest above-the-fold image on
// whichever page it appears on (homepage lead story, or an article's own
// hero) -- likely the LCP element -- so it should never be lazy-loaded,
// and fetchpriority tells the browser to fetch it before other same-priority
// resources. Card thumbnails (grid listings) keep the lazy default since
// most of them are below the fold.
const loading = size === 'lead' ? 'eager' : 'lazy';
const fetchpriority = size === 'lead' ? 'high' : undefined;

// The image-credit link (to the photo's Commons page) and a link to the
// article itself must never nest -- <a> inside <a> is invalid HTML and
// breaks the outer link's accessible name/content. When href is given,
// this component owns the article link itself (wrapping only the image/
// chip/piece), so callers should NOT also wrap <ArticleThumb> in an <a>.
---

<div class={`thumb thumb--${size} ${lensMeta.className}`}>
  {
    href ? (
      <a href={href} class="thumb-link">
        {image && (
          <img
            class="thumb-photo"
            src={src}
            srcset={srcset}
            sizes={srcset ? sizes : undefined}
            alt={alt}
            loading={loading}
            fetchpriority={fetchpriority}
          />
        )}
        {!image && <span class="piece">{piece}</span>}
      </a>
    ) : (
      <>
        {image && (
          <img
            class="thumb-photo"
            src={src}
            srcset={srcset}
            sizes={srcset ? sizes : undefined}
            alt={alt}
            loading={loading}
            fetchpriority={fetchpriority}
          />
        )}
        {!image && <span class="piece">{piece}</span>}
      </>
    )
  }
  {
    image && (
      <a class="thumb-credit" href={image.sourceUrl} target="_blank" rel="noopener" title={image.credit} aria-label={`Image credit: ${image.credit}`}>
        i
      </a>
    )
  }
</div>

<style>
  .thumb-link {
    display: contents;
  }
</style>
