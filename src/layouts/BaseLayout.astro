---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Chess News</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        Partners:
        <a href="https://nordicchessfestival.com" rel="noopener">Nordic Chess Festival</a><!-- TODO: confirm actual domain -->
        &middot;
        <a href="https://chesstournamentcalendar.com" rel="noopener">Chess Tournament Calendar</a>
      </p>
    </footer>
  </body>
</html>
