---
import '../styles/global.css';
import ThemeSwitch from '../components/ThemeSwitch.astro';

interface Props {
  title: string;
  activeSection?: 'front-page' | 'tournaments' | 'nordic-angle' | 'organizers-desk' | 'sources';
}
const { title, activeSection = 'front-page' } = Astro.props;

const today = new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

const sections: Array<{ id: typeof activeSection; label: string; href: string }> = [
  { id: 'front-page', label: 'Front Page', href: '/' },
  { id: 'tournaments', label: 'Tournaments', href: '/#tournament-db' },
  { id: 'nordic-angle', label: 'Nordic Angle', href: '/#nordic-angle' },
  { id: 'organizers-desk', label: "Organizer's Desk", href: '/#organizer-pov' },
  { id: 'sources', label: 'Sources', href: '/#sources' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // Applied before first paint to avoid a flash of the wrong theme --
      // ThemeSwitch.astro owns the toggle interaction itself.
      (function () {
        try {
          var stored = localStorage.getItem('chessori-theme');
          var isDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,380;9..144,460;9..144,560;9..144,620&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;1,400&family=Spectral+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap">
      <div class="masthead-top">
        <span>Vol. I &middot; No. 1</span>
        <span class="masthead-top-right">
          <span class="date">{today}</span>
          <ThemeSwitch />
        </span>
      </div>

      <header class="masthead">
        <h1><a href="/">Chessori</a></h1>
        <div class="tagline">
          Curated chess coverage<span class="sep">&middot;</span>original analysis<span class="sep">&middot;</span>every
          source linked
        </div>
      </header>

      <nav class="sections">
        {
          sections.map((s) => (
            <a href={s.href} class={s.id === activeSection ? 'on' : ''}>
              {s.label}
            </a>
          ))
        }
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>Chessori &middot; Independent chess coverage</span>
        <span class="partners">
          Partners:
          <a href="https://nordicchess.fi" rel="noopener">Nordic Chess Festival</a><span class="sep">&middot;</span><a
            href="https://chesstournamentcalendar.com"
            rel="noopener">Chess Tournament Calendar</a
          >
        </span>
      </footer>
    </div>
  </body>
</html>
