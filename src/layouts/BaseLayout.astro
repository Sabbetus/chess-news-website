---
import '../styles/fonts.css';
import '../styles/global.css';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { CONTINENT_META, CONTINENT_ORDER, type Continent } from '../lib/continent';

interface Props {
  title: string;
  description?: string;
  activeContinent?: Continent | 'front-page';
  articleMeta?: { publishedTime: string; source: string };
}
const DEFAULT_DESCRIPTION =
  'Curated chess news from around the world, with original analysis and tournament statistics you won’t find anywhere else. Every story linked back to its source.';
const {
  title,
  description = DEFAULT_DESCRIPTION,
  activeContinent = 'front-page',
  articleMeta,
} = Astro.props;

const today = new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);

const sections = [
  { id: 'front-page' as const, label: 'Front Page', href: '/' },
  ...CONTINENT_ORDER.map((c) => ({ id: c, label: CONTINENT_META[c].navLabel, href: `/continent/${c}/` })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={articleMeta ? 'article' : 'website'} />
    <meta property="og:site_name" content="Chessori" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {articleMeta && <meta property="article:published_time" content={articleMeta.publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline>
      // Applied before first paint to avoid a flash of the wrong theme --
      // ThemeSwitch.astro owns the toggle interaction itself.
      (function () {
        try {
          var stored = localStorage.getItem('chessori-theme');
          var isDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="wrap">
      <div class="masthead-top">
        <span>Chess news from around the world</span>
        <span class="masthead-top-right">
          <span class="date">{today}</span>
          <ThemeSwitch />
        </span>
      </div>

      <header class="masthead">
        <h1><a href="/">Chessori</a></h1>
        <div class="tagline">
          Chess news &amp; articles<span class="sep">&middot;</span>original analysis<span class="sep">&middot;</span>tournament
          statistics
        </div>
      </header>

      <nav class="sections">
        {
          sections.map((s) => (
            <a href={s.href} class={s.id === activeContinent ? 'on' : ''}>
              {s.label}
            </a>
          ))
        }
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>The next story &middot; Chessori</span>
        <span class="partners">
          Partners:
          <a href="https://nordicchess.fi" target="_blank" rel="noopener">Nordic Chess Festival</a><span class="sep"
            >&middot;</span
          ><a href="https://chesstournamentcalendar.com" target="_blank" rel="noopener">Chess Tournament Calendar</a>
        </span>
      </footer>
    </div>
  </body>
</html>
